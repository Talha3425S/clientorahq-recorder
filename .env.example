# PostgreSQL connection string for the auth API
DATABASE_URL=postgresql://postgres:password@localhost:5432/clientorahq
DATABASE_SSL=false

# SMTP provider used to deliver verification codes
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=ClientoraHQ <no-reply@example.com>

# Cloudflare R2 S3 API credentials (keep the bucket private)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-private-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Generate independent random values, for example with: openssl rand -hex 32
OTP_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-different-long-random-secret

# Exact origin of the frontend. For local Vite, keep this value.
APP_ORIGIN=http://localhost:5173
PORT=3001
