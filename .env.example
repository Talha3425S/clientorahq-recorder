# PostgreSQL connection string for the auth API
DATABASE_URL=postgresql://postgres:password@localhost:5432/clientorahq
DATABASE_SSL=false

# SMTP provider used to deliver verification codes
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=ClientoraHQ <no-reply@example.com>

# Cloudflare R2 S3 API credentials (keep the bucket private)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-private-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Generate independent random values, for example with: openssl rand -hex 32
OTP_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-different-long-random-secret

# Exact origin of the frontend. For local Vite, keep this value.
APP_ORIGIN=http://localhost:5173
PORT=3001

# Optional Slack OAuth contact sync (requires a Slack app with users:read and users:read.email user scopes)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must exactly match a Redirect URL registered in the Slack app; use your HTTPS app URL in production.
SLACK_REDIRECT_URI=

# Optional Google Calendar OAuth (Google Calendar read-only access)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Register this exact URI in the Google OAuth client; by default it uses APP_ORIGIN plus the callback path.
GOOGLE_CALENDAR_REDIRECT_URI=

# Optional Microsoft Outlook Calendar OAuth (Calendars.Read, User.Read, offline_access)
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Register this exact URI in the Microsoft app registration; by default it uses APP_ORIGIN plus the callback path.
MICROSOFT_CALENDAR_REDIRECT_URI=
